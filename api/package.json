{
  "name": "api",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "./main",
    "build": "bun build --compile --minify --outfile main index.ts",
    "push": "bunx --bun drizzle-kit push",
    "generate": "bunx --bun @better-auth/cli generate",
    "drizzle:generate": "bunx --bun drizzle-kit generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1037.0",
    "@aws-sdk/s3-request-presigner": "^3.1037.0",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "^1.4.15",
    "@resumemo/core": "*",
    "amqplib": "^0.10.9",
    "better-auth": "^1.6.9",
    "elysia": "^1.4.28",
    "logixlysia": "^6.3.1",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "bun-types": "^1.3.13",
    "drizzle-kit": "^0.31.10"
  }
}
